# ==============================================================================
# Environment Configuration Template (Copy to .env and adjust values)
# ==============================================================================

PROJECT_NAME="Vehicle Fuel & Mileage Tracking"
API_PREFIX="/api"

SECRET_KEY="transporter_fleet_fuel_secret_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL — format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/vehicle_management"
UPLOAD_DIR="./uploads"

DEFAULT_GEOFENCE_RADIUS_METERS=100
MAX_ALLOWED_GPS_ACCURACY_METERS=50

# Seed Initial Credentials
INITIAL_OWNER_USERNAME="owner"
INITIAL_OWNER_PASSWORD="change_owner_password_here"
INITIAL_OWNER_FULL_NAME="Fleet Owner"

INITIAL_OPERATOR_USERNAME="operator"
INITIAL_OPERATOR_PASSWORD="change_operator_password_here"
INITIAL_OPERATOR_FULL_NAME="Tablet Operator"
