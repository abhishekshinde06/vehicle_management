# Backend API base URL (must include /api prefix)
VITE_API_BASE_URL=http://localhost:8000/api

# Optional development flag: set to "true" only if you want to test against
# the temporary local /api/fuel-entries/upload-photo endpoint while the
# secure photo upload module is under development. Leave "false" otherwise.
VITE_ENABLE_DEV_PHOTO_UPLOAD=false
